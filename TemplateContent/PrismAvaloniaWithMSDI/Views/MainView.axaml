<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:avalonia="using:Material.Icons.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="using:PrismAvaloniaWithMSDI.ViewModels"
             prism:ViewModelLocator.AutoWireViewModel="True"
             x:DataType="viewmodels:MainViewModel"
             x:Class="PrismAvaloniaWithMSDI.Views.MainView"
             x:Name="Main">
  <StackPanel VerticalAlignment="Center" Spacing="4">
    <Button Command="{Binding SwitchThemeCommand}">Switch Theme</Button>
    <Button Command="{Binding ShowNotificationCommand}">Show </Button>
  </StackPanel>
  <Interaction.Behaviors>
    <LoadedTrigger>
      <InvokeCommandAction Command="{Binding SetNotificationHostCommand}" CommandParameter="{Binding #Main}"></InvokeCommandAction>
    </LoadedTrigger>
  </Interaction.Behaviors>
</UserControl>